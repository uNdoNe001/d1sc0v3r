# Optional overrides for docker-compose. Copy to .env if you need them.
#
# By default the compose files assume Ollama runs on the SAME machine as
# d1sc0v3r. Set this only if your Ollama is on a different host.
# D1_LLM_URL=http://192.168.1.50:11434

# Swap models freely — pull whatever you've loaded into Ollama first.
# D1_LLM_MODEL=qwen3:8b

# Set to 0 to disable LLM enrichment entirely (rules-only categorization).
# D1_LLM_ENABLED=1
